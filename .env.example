# ==============================================================================
# RITMO — VARIABLES DE ENTORNO DE PRODUCCIÓN Y DESARROLLO (.env.example)
# Copie este archivo a .env.local para desarrollo local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE POSTGRESQL (Base de datos Soberana)
# ------------------------------------------------------------------------------
# URL del proyecto Supabase (ej. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Clave anónima pública (anon key) para cliente frontend
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key"

# Clave de servicio privilegiada (service_role secret) para backend y crons
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key"

# Token maestro soberano monousuario (usado en headers x-ritmo-token para RLS)
RITMO_MASTER_TOKEN="rtm_sec_a8f9c2d1e04b789123456789abcdef"

# ------------------------------------------------------------------------------
# 2. TELEGRAM BOT API (Interfaz conversacional y notificaciones)
# ------------------------------------------------------------------------------
# Token provisto por @BotFather al crear el bot
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ"

# Secreto para validar peticiones en el webhook (X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET="ritmo_tg_secret_987654321"

# ID numérico único del chat de Lucas (evita que extraños interactúen con el bot)
TELEGRAM_AUTHORIZED_CHAT_ID="123456789"

# ------------------------------------------------------------------------------
# 3. GOOGLE GEMINI 2.0 FLASH (Motor de IA Multimodal)
# ------------------------------------------------------------------------------
# API Key gratuita obtenida en Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere123456"

# ------------------------------------------------------------------------------
# 4. GOOGLE WORKSPACE (Google Classroom & Google Drive para NotebookLM)
# ------------------------------------------------------------------------------
# Credenciales OAuth 2.0 obtenidas en Google Cloud Console
GOOGLE_CLIENT_ID="123456789012-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-yourClientSecretHere"

# Refresh token persistente para renovar access tokens sin intervención humana
GOOGLE_REFRESH_TOKEN="1//04yourRefreshTokenHere-abc123xyz"

# ID de la carpeta en Google Drive donde se depositan los apuntes #utn para NotebookLM
# Si se deja vacío, Ritmo buscará o creará automáticamente la carpeta 'Ritmo - UTN Apuntes'
GOOGLE_DRIVE_FOLDER_ID=""

# ------------------------------------------------------------------------------
# 5. AUTOMATIZACIÓN & CRON JOBS (GitHub Actions / Vercel Cron)
# ------------------------------------------------------------------------------
# Secreto compartido para autenticar invocaciones a /api/cron/*
CRON_SECRET="ritmo_cron_secret_tok_456789123"
